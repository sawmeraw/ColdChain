{
  "compilerOptions": {
    "target": "es2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "outDir": "gen/srv",
    "rootDir": "."
  },
  "include": ["srv", "@cds-models"],
  "exclude": ["node_modules", "gen"]
}
